# SiD OS bootc image — Phase 2 skeleton. NOT a working OS yet.
# D1 (2026-11): Fedora Atomic (bootc) base confirmed.
# packages.txt is the intended package set; CI builds this per PR.
# The Plasma/power/codec content is best-effort until first successful CI build.

ARG BASE=quay.io/fedora/fedora-bootc:latest
FROM ${BASE}

LABEL org.opencontainers.image.title="sidos"
LABEL org.opencontainers.image.description="SiD OS — laptop-first Linux distribution (bootc)"
LABEL org.opencontainers.image.source="https://github.com/sidos/sidos"
LABEL org.opencontainers.image.licenses="MIT"

# RPM Fusion (P7) — codec repos installed from upstream URLs, not Fedora repos
RUN dnf -y install \
    "https://download1.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm" \
    "https://download1.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm"

# Install phase-2 packages (comments and blanks stripped).
COPY packages.txt /tmp/packages.txt
RUN set -eu; \
    PKGS=$(sed 's/#.*//' /tmp/packages.txt | tr -s ' \t' '\n' | grep -v '^$' || true); \
    dnf -y update; \
    dnf -y install ${PKGS}; \
    dnf clean all; \
    rm -rf /tmp/packages.txt

# Reach a graphical login screen (bootc images default to multi-user.target).
# F45 KDE already enables plasma-login-manager as display-manager.service — do not enable sddm.
RUN systemctl set-default graphical.target


# Power stack: power-profiles-daemon is installed via packages.txt;
# TLP evaluation lands in Phase 3 benchmarks (P1).

# bootc sanity check — images must pass this to build (P3).
RUN bootc container lint
